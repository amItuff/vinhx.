{
  "framework": null,
  "buildCommand": "node scripts/changelog.js",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/note/:id",
      "destination": "/note/index.html"
    },
    {
      "source": "/note",
      "destination": "/note/index.html"
    },
    {
      "source": "/convert",
      "destination": "/convert/index.html"
    },
    {
      "source": "/library",
      "destination": "/library/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/note/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/library/books/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/gzip"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(og-image|og-note|og-convert|og-library).png",
      "destination": "/assets/$1.png",
      "permanent": true
    },
    {
      "source": "/icons.svg",
      "destination": "/assets/icons.svg",
      "permanent": true
    }
  ]
}
