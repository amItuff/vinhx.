{
  "framework": null,
  "buildCommand": "node scripts/changelog.js",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/note/:id",
      "destination": "/note/index.html"
    },
    {
      "source": "/note",
      "destination": "/note/index.html"
    },
    {
      "source": "/convert",
      "destination": "/convert/index.html"
    },
    {
      "source": "/library",
      "destination": "/library/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://w.soundcloud.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' https://api.lanyard.rest https://formspree.io; frame-src https://w.soundcloud.com; form-action 'self' https://formspree.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/note/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/library/books/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/gzip"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(og-image|og-note|og-convert|og-library).png",
      "destination": "/assets/$1.png",
      "permanent": true
    },
    {
      "source": "/icons.svg",
      "destination": "/assets/icons.svg",
      "permanent": true
    }
  ]
}
